---
const {size = 16, color = "#FF0000"} = Astro.props;
const color_code = color.startsWith("#") ? color : `#${color}`;
---

<svg xmlns='http://www.w3.org/2000/svg' width={size} height={size} fill={color_code} viewBox='0 0 256 256'
	><rect width={size} height={size} fill='none'></rect><line x1='200' y1='56' x2='56' y2='200' stroke={color_code} stroke-linecap='round' stroke-linejoin='round' stroke-width='16'></line><line
		x1='200'
		y1='200'
		x2='56'
		y2='56'
		stroke={color_code}
		stroke-linecap='round'
		stroke-linejoin='round'
		stroke-width='16'></line></svg
>
