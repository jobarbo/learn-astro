---
const {title, description, tag} = Astro.props as {title: string; description: string; tag: boolean};
const tag_text = tag ? "Most Popular" : "";
---

<div class='card__body'>
	{tag && <p class='card__tag'>{tag_text}</p>}
	<p class='card__title'>{title}</p>
	<p class='card__description'>{description}</p>
</div>

<style lang='scss'>
	.card__body {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 0.5em;
	}
	.card__title {
		font-size: 24px;
		font-weight: 600;
		color: #000;
		font-family: "Helvetica", sans-serif;
		text-align: center;
	}
	.card__description {
		font-size: 16px;
		font-weight: 400;
		color: #000;
		font-family: "Helvetica", sans-serif;
		text-align: center;
	}
	.card__tag {
		font-size: 12px;
		font-weight: 400;
		color: #fff;
		font-family: "Helvetica", sans-serif;
		text-align: center;
		background-color: #000;
		padding: 0.5em 1em;
		border-radius: 0.5em;
	}
</style>
