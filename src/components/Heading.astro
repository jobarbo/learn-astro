---
const sizes = {
	title1: "h1",
	title2: "h2",
	title3: "h3",
	title4: "h4",
	title5: "h5",
	title6: "h6",
};

const {tag, size, ...rest} = Astro.props;
const CustomTag = tag;
---

<CustomTag class:list={["default", sizes[size]]} {...rest}>
	<slot />
</CustomTag>

<style>
	.default {
		line-height: 1.1;
		text-wrap: balance;
	}

	.title1,
	.h1 {
		font-size: 4rem;
	}

	.title2,
	.h2 {
		font-size: 3.5rem;
	}

	.title3,
	.h3 {
		font-size: 3rem;
	}
	.title4,
	.h4 {
		font-size: 2.5rem;
	}
	.title5,
	.h5 {
		font-size: 2rem;
	}
	.title6,
	.h6 {
		font-size: 1.5rem;
	}
</style>
