---
import {type HTMLAttributes} from "astro/types";

const sizes = {
	h1: "title1",
	h2: "title2",
	h3: "title3",
	h4: "title4",
	h5: "title5",
	h6: "title6",
	a: "link",
};

interface Props extends HTMLAttributes<keyof typeof sizes> {
	tag: keyof typeof sizes;
	size: keyof typeof sizes;
	classes?: string;
	href?: string;
}

const {tag, size, classes, ...rest} = Astro.props;
const CustomTag = tag;
---

<CustomTag class:list={["default", sizes[size], classes]} {...rest}>
	<slot />
</CustomTag>

<style>
	.default {
		line-height: 1.1;
		text-wrap: balance;
	}

	.title1,
	.h1 {
		font-size: 4rem;
	}

	.title2,
	.h2 {
		font-size: 3.5rem;
	}

	.title3,
	.h3 {
		font-size: 3rem;
	}
	.title4,
	.h4 {
		font-size: 2.5rem;
	}
	.title5,
	.h5 {
		font-size: 2rem;
	}
	.title6,
	.h6 {
		font-size: 1.5rem;
	}

	.text-center {
		text-align: center;
	}

	.underline {
		text-decoration: underline;
	}
</style>
