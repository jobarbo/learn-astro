---
const {category, contextClass, categoryColor} = Astro.props;
---

<p class={`${contextClass} badge`} style={`--category-color: ${categoryColor}`}>{category}</p>

<style>
	.card__badge {
		padding: 0.25rem 0.75rem;
		border-radius: 100vw;
		background-color: var(--category-color);
		line-height: 1;
		color: #fff;
		font-size: 0.55rem;
		font-weight: 400;
		text-transform: uppercase;
		width: fit-content;
		margin-bottom: 0.5rem;
	}
</style>
