---
const {card} = Astro.props as {card: any};
import CardHeader from "@/components/CardHeader.astro";
import CardBody from "@/components/CardBody.astro";
import Button from "@/components/Button.astro";
import List from "@/components/List.astro";
---

<div class='pricing__card card' id='animate-anything-css'>
	<CardHeader tier={card.tier} />
	<CardBody title={card.title} description={card.description} tag={card.most_popular} />
	<Button label={card.btn_text} theme={card.tier} />
	<List array={card.features} />
</div>

<style lang='scss'>
	.card {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		background-color: #fff;
		border-radius: 1em;
		padding: 3.25em 2em 2em 2em;
		box-shadow: 0px 20px 25px 0px rgba(194, 194, 214, 0.3);
		height: auto;
		gap: 1em;
		position: relative;
		overflow: hidden;
	}
</style>
