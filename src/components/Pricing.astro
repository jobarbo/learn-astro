---
import PricingCard from "./PricingCard.astro";
const {cards} = Astro.props as {cards: any[]};
---

<section class='pricing'>
	<div class='pricing__container'>
		<div class='pricing__card-list'>
			{cards.map((card: any) => <PricingCard card={card} />)}
		</div>
	</div>
</section>
<style lang='scss'>
	.pricing {
		width: 100%;
		height: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
		&__container {
			background-color: #eeeeff;
			width: fit-content;
			border-radius: 1em;
			display: flex;
			justify-content: center;
			align-items: center;
			padding: 5em 6em;
		}

		&__card-list {
			display: flex;
			justify-content: center;
			align-items: center;
			gap: 2em;
		}
	}
</style>
