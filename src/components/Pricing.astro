---
import Card from "./Card.astro";
import Heading from "./Heading.astro";
const {cards} = Astro.props as {cards: any[]};
---

<section class='pricing'>
	<div class='pricing__container'>
		<Heading text='Pricing' tag='h2' class='--title1' />
		<div class='pricing__card-list'>
			{cards.map((card: any) => <Card card={card} />)}
		</div>
	</div>
</section>
<style lang='scss'>
	.pricing {
		width: 100%;
		height: 100%;
		min-height: 60vh;
		display: flex;
		justify-content: center;

		&__container {
			background-color: #eeeeff;
			width: fit-content;
			border-radius: 1em;
			display: flex;
			flex-direction: column;
			gap: 2.25em;
			justify-content: center;
			align-items: center;
			height: auto;
			padding: 2em 6em;
		}

		&__card-list {
			display: grid;
			gap: 2em;
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
