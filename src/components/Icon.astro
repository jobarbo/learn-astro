---
const {
	index = 0,
	size = 21,
	color = "#000",
} = Astro.props as {
	index?: number;
	size?: number;
	color?: string;
};
const color_code = color.startsWith("#") ? color : `#${color}`;
---

{
	index === 0 && (
		/* Check (filled) */
		<svg xmlns='http://www.w3.org/2000/svg' width={size} height={size} viewBox='0 0 15 15' fill='none'>
			<path fill={color_code} d='M10.602 3.908a.626.626 0 0 1 1.046.684l-4.25 6.5a.626.626 0 0 1-.944.12l-2.75-2.5l-.084-.094a.626.626 0 0 1 .823-.906l.103.075l2.207 2.006z' />
		</svg>
	)
}

{
	index === 1 && (
		/* Cross (stroked) */
		<svg xmlns='http://www.w3.org/2000/svg' width={size} height={size} viewBox='0 0 15 15'>
			<path
				fill={color_code}
				d='M10.969 3.219a.574.574 0 1 1 .812.812L8.313 7.5l3.468 3.469l.074.09a.575.575 0 0 1-.796.796l-.09-.074L7.5 8.312l-3.469 3.47a.574.574 0 1 1-.812-.813L6.688 7.5l-3.47-3.469l-.073-.09a.575.575 0 0 1 .796-.797l.09.075L7.5 6.687z'
			/>
		</svg>
	)
}
