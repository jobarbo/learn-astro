---
const {
	index = 0,
	size = 21,
	color = "#000",
} = Astro.props as {
	index?: number;
	size?: number;
	color?: string;
};
const color_code = color.startsWith("#") ? color : `#${color}`;
---

{
	index === 0 && (
		/* Check (filled) */
		<svg xmlns='http://www.w3.org/2000/svg' width={size} height={size} fill={color_code} viewBox='0 0 256 256'>
			<path d='M229.66,77.66l-128,128a8,8,0,0,1-11.32,0l-56-56a8,8,0,0,1,11.32-11.32L96,188.69,218.34,66.34a8,8,0,0,1,11.32,11.32Z' />
		</svg>
	)
}

{
	index === 1 && (
		/* Cross (stroked) */
		<svg xmlns='http://www.w3.org/2000/svg' width={size} height={size} viewBox='0 0 256 256' fill='none'>
			<line x1='200' y1='56' x2='56' y2='200' stroke={color_code} stroke-linecap='round' stroke-linejoin='round' stroke-width='16' />
			<line x1='200' y1='200' x2='56' y2='56' stroke={color_code} stroke-linecap='round' stroke-linejoin='round' stroke-width='16' />
		</svg>
	)
}
