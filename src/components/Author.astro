---
const {author, time, contextClass} = Astro.props;
---

<div class=`${contextClass}  author`>
	<div class='author__image-container'>
		<img src={author.avatar} alt='' class='author__image' />
	</div>
	<div class='author__text'>
		<p class='author__author'>{author.name}</p>
		<p class='author__time'>{time}</p>
	</div>
</div>

<style>
	.author {
		padding: 1.5rem;
		display: flex;
		align-items: center;
		justify-content: flex-start;
		margin-top: auto;
		justify-self: flex-end;
		gap: 0.5rem;
	}

	.author__image-container {
		width: 3rem;
		height: 3rem;
		border-radius: 100%;
		overflow: hidden;
		aspect-ratio: 1/1;
	}

	.author__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		aspect-ratio: 1/1;
	}

	.author__text {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.author__author {
		font-size: 0.875rem;
		font-weight: 600;
		margin: 0;
	}

	.author__time {
		font-size: 0.75rem;
		font-weight: 400;
		margin: 0;
	}
</style>
