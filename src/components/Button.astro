---
const {label} = Astro.props as {label: string};
---

<a href={label} class='card__btn'>
	{label}
</a>

<style lang='scss'>
	.card__btn {
		font-size: 16px;
		font-weight: 600;
		color: #fff;
		font-family: "Helvetica", sans-serif;
		text-align: center;
		background-color: #000;
		padding: 1em 2em;
		border-radius: 0.5em;
		text-decoration: none;
		transition: all 0.3s ease;
	}
	.card__btn:hover {
		background-color: #2e2e2e;
		color: #fff;
	}
</style>
