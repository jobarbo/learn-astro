---
const {label, tier} = Astro.props as {label: string; tier: string};
const tier_class = tier.toLowerCase().replace(" ", "-");
---

<a href={label} class={`card__btn --${tier_class}`}>
	{label}
</a>

<style lang='scss'>
	.card__btn {
		font-size: 16px;
		font-weight: 600;
		color: #fff;
		font-family: "Helvetica", sans-serif;
		text-align: center;
		background-color: #000;
		padding: 1em 2em;
		border-radius: 0.5em;
		text-decoration: none;
		transition: all 0.3s ease;
	}
	.card__btn:hover {
		background-color: #2e2e2e;
		color: #fff;
	}

	.card__btn.--free {
		background-color: transparent;
		color: #000;
		border: 2px solid #000;

		&:hover {
			background-color: #000;
			color: #fff;
		}
	}
	.card__btn.--pro {
		background-color: #4c4cb2;
		border: 2px solid #4c4cb2;
		&:hover {
			background-color: transparent;
			color: #4c4cb2;
		}
	}
	.card__btn.--enterprise {
		background-color: transparent;
		color: #d0aa25;
		border: 2px solid #d0aa25;

		&:hover {
			background-color: #d0aa25;
			color: #fff;
		}
	}
</style>
