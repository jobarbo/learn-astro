---
import Icon from "@/components/Icon.astro";
const {icon = false, text = "placeholder"} = Astro.props as {icon: boolean; text: string};

import Logo from "@/assets/favicon.svg";

const color = icon ? "#1EAC3E" : "#D93535";
---

<li class='list__item'>
	<p class='list__item-text'>
		<span class='list__item-icon'>
			<Logo width={25} height={25} fill={color} stroke={color} />
		</span>
		{text}
	</p>
</li>

<style lang='scss'>
	.list__item {
		display: flex;
		align-items: center;
		gap: 1em;
	}
	.list__item-text {
		font-size: 16px;
		font-weight: 400;
		color: #000;
		font-family: "Helvetica", sans-serif;
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.list__item-icon {
		font-size: 16px;
		font-weight: 400;
		color: #000;
		font-family: "Helvetica", sans-serif;
	}
</style>
