---
import Layout from "../layouts/layout.astro";

import Button from "../components/Button.astro";
import Heading from "../components/Heading.astro";
const headings = [
	{tag: "h1", size: "title1", text: "Heading 1"},
	{tag: "h2", size: "title2", text: "Heading 2"},
	{tag: "h3", size: "title3", text: "Heading 3"},
	{tag: "h4", size: "title4", text: "Heading 4"},
	{tag: "h5", size: "title5", text: "Heading 5"},
	{tag: "h6", size: "title6", text: "Heading 6"},
];
---

<Layout>
	{
		headings.map((heading) => {
			return (
				<Heading tag={heading.tag} size={heading.size}>
					{heading.text}
				</Heading>
			);
		})
	}

	<Button id='btn-1' aria-label='Button 1' data-testid='btn-1'>Click me</Button>
</Layout>

<script>
	let btn = document.querySelector('[data-testid="btn-1"]') as HTMLElement | null;
	btn?.addEventListener("mouseover", () => {
		btn.style.backgroundColor = "var(--surface-3)";
	});
	btn?.addEventListener("mouseout", () => {
		btn.style.backgroundColor = "var(--background)";
	});
</script>

<style>
	@import "https://unpkg.com/open-props";
	@import "https://unpkg.com/open-props/normalize.min.css";
	@import "../styles/global.css";

	body {
		display: grid;
		place-content: center;
		gap: 1.5rem;
		padding: 1.5rem;
		background-color: rgb(43, 44, 70);
	}

	h1 {
		color: white;
	}
</style>
