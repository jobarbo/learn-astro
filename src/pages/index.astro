---
import Button from "../components/Button.astro";
---

<html lang='en'>
	<head>
		<meta charset='utf-8' />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<meta name='viewport' content='width=device-width' />
		<meta name='generator' content={Astro.generator} />
		<title>Astro Components</title>
	</head>
</html>
<body>
	<h1>Astro Components</h1>

	<Button id='btn-1' aria-label='Button 1' data-testid='btn-1' isBordered={true} border_color='var(--border-col)' background='var(--bg-col)' color='var(--font-col)'>Click Me</Button>

	<Button id='btn-2' aria-label='Button 1' data-testid='btn-1' isBordered={true}>Click Me</Button>
</body>
<script>
	let btn = document.querySelector('[data-testid="btn-1"]') as HTMLElement | null;
	btn?.addEventListener("mouseover", () => {
		btn.style.backgroundColor = "var(--surface-3)";
	});
	btn?.addEventListener("mouseout", () => {
		btn.style.backgroundColor = "var(--background)";
	});
</script>
<style>
	@import "https://unpkg.com/open-props";
	@import "https://unpkg.com/open-props/normalize.min.css";
	@import "../styles/global.css";

	body {
		display: grid;
		place-content: center;
		gap: 1.5rem;
		padding: 1.5rem;
		background-color: rgb(43, 44, 70);
	}

	h1 {
		color: white;
	}
</style>
