---

<Layout>
	<section class='products'>
		<div class='products__categories'>
			<button data-product-category='all' class='products__categories-button'>All</button>
			{
				categories.map((category) => (
					<button data-product-category={category} class='products__categories-button'>
						{category}
					</button>
				))
			}
		</div>
		<div class='products__container'>
			<h1>Products</h1>
			<div data-products-list class='products__list'>
				{
					products.map((product) => (
						<div data-product-card data-product-category={product.category} class='product__card'>
							<div class='product__card-image'>
								<img src={product.image} alt={product.name} />
							</div>
							<div class='product__card-content'>
								<h2>{product.name}</h2>
								<p>{product.category}</p>
								<p>{product.description}</p>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>
</Layout>

<script>
	import gsap from "gsap";
	import {Flip} from "gsap/Flip";
	gsap.registerPlugin(Flip);

	const container = document.querySelector("[data-products-list]") as HTMLElement;
	const allButton = document.querySelector("[data-product-category='all']") as HTMLElement;
	const filters = gsap.utils.toArray("[data-product-category]") as HTMLElement[];
	const items = gsap.utils.toArray("[data-product-card]") as HTMLElement[];
	let containerHeight = container.offsetHeight;

	function updateFilters() {
		const state = Flip.getState(items);

		// Check if "All" button is active
		if (allButton.classList.contains("active")) {
			// Show all items
			items.forEach((item) => (item.style.display = "inline-flex"));
		} else {
			// Get the single active filter category
			const activeButton = filters.find((button) => button.classList.contains("active"));

			if (activeButton) {
				const activeCategory = activeButton.dataset.productCategory;

				// Filter items based on the single active category
				items.forEach((item) => {
					const itemCategories = item.dataset.productCategory.split(",");
					const shouldShow = itemCategories.includes(activeCategory);
					item.style.display = shouldShow ? "inline-flex" : "none";
				});
			} else {
				// No active filter, show all items
				items.forEach((item) => (item.style.display = "inline-flex"));
			}
		}

		// Set container height to current height to prevent collapse during animation
		container.style.height = containerHeight + "px";

		// animate from the previous state
		Flip.from(state, {
			duration: 0.4,
			scale: true,
			absolute: true,
			ease: "power2.inOut",
			onEnter: (elements) => gsap.fromTo(elements, {opacity: 0, scale: 0}, {opacity: 1, scale: 1, duration: 0.4}),
			onLeave: (elements) => gsap.to(elements, {opacity: 0, scale: 0, duration: 0.4}),
			onComplete: () => {
				// After animation, smoothly transition to new height

				// Reset to auto to get natural height
				container.style.height = "fit-content";
				const newHeight = container.offsetHeight;
				console.log("New height:", newHeight);

				// Animate height transition
				gsap.fromTo(
					container,
					{height: containerHeight + "px"},
					{
						height: newHeight + "px",
						duration: 0.3,
						ease: "power2.inOut",
						onComplete: () => {
							// Reset to auto after animation
							container.style.height = "auto";
							containerHeight = newHeight;
						},
					}
				);
			},
		});
	}

	filters.forEach((filter) =>
		filter.addEventListener("click", (e: Event) => {
			// Remove active class from all buttons first
			filters.forEach((button) => button.classList.remove("active"));
			allButton.classList.remove("active");

			// Add active class only to clicked button
			(e.target as HTMLElement).classList.add("active");
			updateFilters();
		})
	);

	allButton.addEventListener("click", () => {
		// Remove active class from all filter buttons
		filters.forEach((button) => button.classList.remove("active"));
		// Add active class to all button
		allButton.classList.add("active");
		updateFilters();
	});
</script>

<style>
	* {
		box-sizing: border-box;
	}
	.products {
		width: 100%;
		height: 100%;

		padding: 5rem;
		> * {
			font-family: "PP Fraktion Mono";
		}
	}

	.products__categories {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	.products__categories-button {
		padding: 0.5rem 1rem;
		border-radius: 0.5rem;
		border: 1px solid #ccc;
		cursor: pointer;
	}

	.products__categories-button:hover {
		background-color: #ccc;
	}

	.products__categories-button.active {
		background-color: #007bff;
		color: white;
		border-color: #007bff;
	}

	.products__container {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border: 1px solid red;
	}

	.products__list {
		width: 100%;
		position: relative;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));

		align-items: flex-start;
		justify-content: flex-start;
		gap: 1rem;
	}

	.product__card {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		width: 100%; /* Fixed width prevents layout shifts */
		border: 1px solid #ccc;
		background-color: #fff;
		border-radius: 0.5rem;
		box-shadow: 0 0 10px 0 rgba(0, 0, 0, 0.1);
		cursor: pointer;
		backface-visibility: hidden;
		will-change: transform, opacity;
	}

	.product__card:hover {
		transform: scale(1.05);
		box-shadow: 0 0 20px 0 rgba(0, 0, 0, 0.2);
	}

	.product__card.is-hidden {
		pointer-events: none;
	}

	.product__card-image {
		aspect-ratio: 16/9;
		width: 100%;
		height: auto;
		overflow: hidden;
	}

	.product__card-image img {
		aspect-ratio: 16/9;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.product__card-content {
		padding: 1rem 0.5rem 2rem 0.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	.product__card-content h2 {
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1.1;
		color: var(--text-1);
		margin: 0;
	}

	.product__card-content p {
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.1;
		color: var(--text-2);
		margin: 0;
	}
</style>
